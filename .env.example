# Copia este archivo a .env. Lo leen docker-compose.yml (interpolación) y el
# contenedor app (env_file). Las variables comentadas usan el valor por defecto.

# Obligatorio: openssl rand -hex 32
AUTH_JWT_SECRET=change-me-with-openssl-rand-hex-32

# ---------------------------------------------------------------- auth
# AUTH_ACCESS_TTL_MINUTES=15
# AUTH_REFRESH_TTL_MINUTES=10080
# AUTH_REDIS_PASSWORD=
# Sin AUTH_SMTP_HOST los correos (con el código) se escriben en el log de app:
#   docker compose logs app | grep -A2 '\[mail\]'
# AUTH_SMTP_HOST=smtp.example.com
# AUTH_SMTP_PORT=587
# AUTH_SMTP_USERNAME=
# AUTH_SMTP_PASSWORD=
# AUTH_SMTP_TLS=true
# AUTH_SMTP_AUTH=true
# AUTH_SMTP_FROM=
# true en producción (HTTPS); false para probar contra http://localhost:8000.
AUTH_COOKIE_SECURE=false

# ---------------------------------------------------------- detección
# SENSOR_TOKEN_TTL_MINUTES=1440
# EVIDENCE_RETENTION_DAYS=30
# ALERT_RETENTION_DAYS=0
# REPORT_TIMEZONE=America/Bogota
# OLLAMA_BASE_URL=http://ollama:11434
# OLLAMA_MODEL=gemma3:4b

# -------------------------------------------------------------- puertos
# API directa (sin Caddy), solo en 127.0.0.1 por defecto.
# API_PORT=8000
# Puerto TLS del agente al que se conectan las capturas.
# AGENT_PORT=8443
# Docker rootless no abre puertos < 1024.
HTTP_PORT=8080
HTTPS_PORT=8444

# ----------------------------------------------------------- producción
# Dominios que apuntan a la central. Caddy emite sus certificados.
# API_DOMAIN=api.example.com
# AGENT_DOMAIN=agent.example.com
# ACME_EMAIL=ops@example.com
# El agente usa el certificado de AGENT_DOMAIN que guarda Caddy:
# TLS_CERT=/caddy/caddy/certificates/acme-v02.api.letsencrypt.org-directory/agent.example.com/agent.example.com.crt
# TLS_KEY=/caddy/caddy/certificates/acme-v02.api.letsencrypt.org-directory/agent.example.com/agent.example.com.key
# Lo que recibe la captura al inscribirse:
# PUBLIC_API_URL=https://api.example.com
# AGENT_PUBLIC_ENDPOINT=tls://agent.example.com:8443
# AGENT_TLS_SERVER_NAME=agent.example.com
# Vacío con certificado público (la captura usa las CA del sistema):
# AGENT_CA_PATH=
# Imagen del comando de instalación que muestra la web:
# CAPTURE_IMAGE=ghcr.io/agentiot/capture:latest
