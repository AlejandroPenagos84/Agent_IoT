# Copy this file to .env and fill in the real values.
AUTH_DB_PATH=/data/auth.db
AUTH_JWT_SECRET=change-me-with-openssl-rand-hex-32
AUTH_ACCESS_TTL_MINUTES=15
AUTH_REFRESH_TTL_MINUTES=10080

AUTH_REDIS_HOST=redis
AUTH_REDIS_PORT=6379
AUTH_REDIS_DB=0
AUTH_REDIS_PASSWORD=

AUTH_SMTP_HOST=smtp.example.com
AUTH_SMTP_PORT=587
AUTH_SMTP_USERNAME=
AUTH_SMTP_PASSWORD=
AUTH_SMTP_TLS=true
AUTH_SMTP_AUTH=true
AUTH_SMTP_FROM=

AUTH_COOKIE_NAME=auth_refresh
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_PATH=/api/v1/auth

AUTH_API_PORT=8001

# Registro de brokers/sensores y alertas (API de detección)
DETECTION_DB_PATH=/data/detection.db
ALERTS_DIR=/alerts

# Desarrollo: dueño del Mosquitto local que `bootstrap` registra al hacer `up`.
# Usa tu user id (GET /api/v1/auth/me) para ver los reportes con tu token.
DEV_TENANT_ID=
DEV_BROKER_NAME=mosquitto-dev

# Producción (docker-compose.prod.yml): dominios que apuntan a la central.
API_DOMAIN=api.example.com
AGENT_DOMAIN=agent.example.com
ACME_EMAIL=ops@example.com
AGENT_PORT=8443
# public (Let's Encrypt vía Caddy) o self-signed (CA de certgen; laboratorio).
AGENT_CERT_MODE=public
# Con self-signed: /certs/agent/ca.crt, la API la entrega a cada captura.
AGENT_CA_PATH=
# Imagen que aparece en el comando de instalación de la web.
CAPTURE_IMAGE=ghcr.io/agentiot/capture:latest
# Duración del token de sensor; la captura lo renueva sola.
SENSOR_TOKEN_TTL_MINUTES=1440
