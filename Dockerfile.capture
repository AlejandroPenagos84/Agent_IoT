FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src

RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends tshark && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app
# Solo la captura y el contrato compartido: sin el agente ni sus dependencias.
COPY src/capture /app/src/capture
COPY src/wire /app/src/wire

# Con ENROLL_KEY y API_URL se inscribe sola y usa el agente que indica la API.
VOLUME ["/state"]
ENTRYPOINT ["python", "-m", "capture"]
CMD ["--iface", "eth0", "--exclude-topic", "alertas/deteccion"]
