FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src

RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends tshark && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app
# Solo el recolector: sin numpy, pandas ni el resto del agente.
COPY src/detection/__init__.py /app/src/detection/__init__.py
COPY src/detection/infrastructure/__init__.py /app/src/detection/infrastructure/__init__.py
COPY src/detection/infrastructure/tshark/__init__.py src/detection/infrastructure/tshark/stream_features.py src/detection/infrastructure/tshark/tshark_schema.py src/detection/infrastructure/tshark/tcp_window_features.py /app/src/detection/infrastructure/tshark/

ENTRYPOINT ["python", "-m", "detection.infrastructure.tshark.stream_features"]
CMD ["--iface", "eth0", "--out", "/capture/features.jsonl"]
