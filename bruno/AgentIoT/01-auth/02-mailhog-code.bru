meta {
  name: Read latest code from Mailhog
  type: http
  seq: 3
}

get {
  url: {{mailhogUrl}}/api/v2/search?kind=to&query={{email}}
}

script:post-response {
  const items = res.body.items || [];
  const message = items.length ? items[0] : null;
  const headers = message ? (message.Content.Headers || {}) : {};
  let body = message ? (message.Content.Body || "") : "";
  const encoding = (headers["Content-Transfer-Encoding"] || [])[0] || "";
  if (encoding === "base64") {
    try {
      const decode = require("atob");
      body = decode(body.replace(/\s/g, ""));
    } catch (e) {
      // The user can paste the code manually if decoding fails.
    }
  }
  const match = body.match(/\b(\d{6})\b/);
  if (match) {
    bru.setVar("emailCode", match[1]);
  }
}

tests {
  test("mailhog returns the user's message", function() {
    expect(res.status).to.equal(200);
    expect(res.body.items).to.be.an("array");
  });
}
