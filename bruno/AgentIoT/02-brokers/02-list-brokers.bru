meta {
  name: List brokers
  type: http
  seq: 3
}

get {
  url: {{apiUrl}}/api/v1/brokers
}

headers {
  Authorization: Bearer {{accessToken}}
}

tests {
  test("lists the user's brokers", function() {
    expect(res.status).to.equal(200);
    expect(res.body).to.be.an("array");
    expect(res.body.length).to.be.at.least(1);
  });
}
