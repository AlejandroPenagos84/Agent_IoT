meta {
  name: Broker status
  type: http
  seq: 6
}

get {
  url: {{apiUrl}}/api/v1/brokers/{{brokerId}}
}

headers {
  Authorization: Bearer {{accessToken}}
}

tests {
  test("broker is connected after enrollment", function() {
    expect(res.status).to.equal(200);
    expect(res.body.status).to.equal("connected");
    expect(res.body.sensor_id).to.equal(bru.getVar("sensorId"));
  });
}
