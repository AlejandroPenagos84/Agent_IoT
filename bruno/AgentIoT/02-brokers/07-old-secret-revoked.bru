meta {
  name: Old capture is revoked after rotation
  type: http
  seq: 8
}

post {
  url: {{apiUrl}}/api/v1/sensors/token/refresh
}

headers {
  Authorization: Bearer {{sensorSecret}}
}

tests {
  test("the previous sensor secret no longer works", function() {
    expect(res.status).to.equal(401);
  });
}
