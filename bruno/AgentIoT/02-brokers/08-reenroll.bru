meta {
  name: Reinstall capture with the new key
  type: http
  seq: 9
}

post {
  url: {{apiUrl}}/api/v1/sensors/enroll
}

headers {
  Content-Type: application/json
}

body {
  {
    "enrollment_key": "{{enrollmentKey}}",
    "name": "{{sensorName}}"
  }
}

script:post-response {
  bru.setVar("sensorToken", res.body.access_token);
  bru.setVar("sensorSecret", res.body.sensor_secret);
}

tests {
  test("same sensor id, new credentials", function() {
    expect(res.status).to.equal(201);
    expect(res.body.sensor_id).to.equal(bru.getVar("sensorId"));
  });
}
