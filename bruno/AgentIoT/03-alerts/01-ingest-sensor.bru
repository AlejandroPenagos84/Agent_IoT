meta {
  name: Ingest alert with sensor token
  type: http
  seq: 1
}

post {
  url: {{apiUrl}}/api/v1/alerts
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{sensorToken}}
}

body {
  {
    "alert_id": "alert-{{$randomUUID}}",
    "ts": 1800000000,
    "kind": "class",
    "label": "ataque",
    "tenant_id": "{{tenantId}}",
    "broker_id": "{{brokerId}}",
    "sensor_id": "{{sensorId}}"
  }
}

script:post-response {
  bru.setVar("alertId", res.body.alert_id);
}

tests {
  test("sensor alert is stored", function() {
    expect(res.status).to.equal(201);
    expect(res.body.stored).to.equal(true);
  });
}
