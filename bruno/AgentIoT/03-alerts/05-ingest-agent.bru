meta {
  name: Ingest alert with agent token
  type: http
  seq: 5
}

post {
  url: {{apiUrl}}/api/v1/alerts
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{agentToken}}
}

body {
  {
    "alert_id": "agent-alert-{{$randomUUID}}",
    "ts": 1800000001,
    "kind": "class",
    "label": "ataque",
    "tenant_id": "{{tenantId}}",
    "broker_id": "{{brokerId}}",
    "sensor_id": "{{sensorId}}"
  }
}

tests {
  test("agent alert is stored", function() {
    expect(res.status).to.equal(201);
    expect(res.body.stored).to.equal(true);
  });
}
