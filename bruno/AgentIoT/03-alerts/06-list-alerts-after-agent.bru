meta {
  name: List alerts after agent ingestion
  type: http
  seq: 6
}

get {
  url: {{apiUrl}}/api/v1/alerts?limit=100
}

headers {
  Authorization: Bearer {{accessToken}}
}

tests {
  test("sensor and agent alerts are listed", function() {
    expect(res.status).to.equal(200);
    expect(res.body).to.be.an("array");
    expect(res.body.length).to.be.at.least(2);
  });
}
