meta {
  name: Analytical report for broker
  type: http
  seq: 1
}

get {
  url: {{apiUrl}}/api/v1/reports/analytics?broker_id={{brokerId}}&now=2027-01-15T09:00:00Z
}

headers {
  Authorization: Bearer {{accessToken}}
}

tests {
  test("report is scoped to the broker", function() {
    expect(res.status).to.equal(200);
    expect(res.body.scope.broker_id).to.equal(bru.getVar("brokerId"));
    expect(res.body.general.total_alerts).to.be.a("number");
    res.body.brokers.forEach(function(item) {
      expect(item.broker_id).to.equal(bru.getVar("brokerId"));
    });
  });
}
