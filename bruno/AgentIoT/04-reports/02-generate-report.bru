meta {
  name: Generate natural report
  type: http
  seq: 2
}

post {
  url: {{apiUrl}}/api/v1/reports
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

body {
  {
    "broker_id": "{{brokerId}}"
  }
}

tests {
  test("natural report is generated (requires Ollama)", function() {
    expect(res.status).to.equal(200);
    expect(res.body.report).to.be.a("string");
  });
}
