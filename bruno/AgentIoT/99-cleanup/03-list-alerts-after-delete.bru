meta {
  name: Alerts survive broker deletion
  type: http
  seq: 3
}

get {
  url: {{apiUrl}}/api/v1/alerts?limit=100
}

headers {
  Authorization: Bearer {{accessToken}}
}

tests {
  test("alerts are preserved", function() {
    expect(res.status).to.equal(200);
    expect(res.body).to.be.an("array");
    expect(res.body.length).to.be.at.least(2);
  });
}
