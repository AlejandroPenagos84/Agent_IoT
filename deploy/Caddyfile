# Entrada HTTPS de la central. Con dominios reales Caddy usa Let's Encrypt;
# con *.localhost usa su CA interna.
{
	email {$ACME_EMAIL}
	# Laboratorio sin dominio público: CADDY_EXTRA_GLOBAL=local_certs
	{$CADDY_EXTRA_GLOBAL}
}

{$API_DOMAIN} {
	encode gzip
	request_body {
		max_size 1MB
	}
	# nginx (web) sirve el frontend y reenvía /api a app:8000.
	reverse_proxy web:80
	header -Server
}

# Solo existe para que Caddy emita el certificado del agente. El tráfico de
# captura va directo a app:8443, que reutiliza este certificado (TLS_CERT).
{$AGENT_DOMAIN} {
	respond "agent-iot" 200
}
